@using ReservaTuCitaYa.Application.DTOs.Common
@model ReservaTuCitaYa.Web.ViewModels.Sedes.SedeIndexViewModel
@{ ViewData["Title"] = "Sedes"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="mb-0">Sedes</h1><span class="text-muted">@Model.Organizacion</span></div>
    <a asp-action="Create" asp-route-organizacionId="@Model.OrganizacionId" class="btn btn-primary">Nueva sede</a>
</div>
<form method="get" class="card card-body mb-3">
    <input type="hidden" asp-for="OrganizacionId" />
    <div class="row g-2 align-items-end">
        <div class="col-md-7"><label asp-for="Busqueda" class="form-label">Buscar</label><input asp-for="Busqueda" class="form-control" placeholder="Nombre o dirección" /></div>
        <div class="col-md-3"><label asp-for="Estado" class="form-label">Estado</label><select asp-for="Estado" class="form-select"><option value="@EstadoFiltro.Todos">Todos</option><option value="@EstadoFiltro.Activos">Activos</option><option value="@EstadoFiltro.Inactivos">Inactivos</option></select></div>
        <div class="col-md-2 d-grid"><button type="submit" class="btn btn-outline-primary">Filtrar</button></div>
    </div>
</form>
<div class="table-responsive"><table class="table table-striped align-middle">
    <thead><tr><th>Nombre</th><th>Dirección</th><th>Contacto</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @if (Model.Sedes.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">No se encontraron sedes.</td></tr> }
    @foreach (var sede in Model.Sedes) {
        <tr><td>@sede.Nombre</td><td>@sede.Direccion</td><td>@(sede.Correo ?? sede.Telefono ?? "—")</td><td><span class="badge @(sede.EstaActivo ? "bg-success" : "bg-secondary")">@(sede.EstaActivo ? "Activa" : "Inactiva")</span></td><td class="text-end"><a asp-action="Details" asp-route-id="@sede.Id" class="btn btn-sm btn-outline-primary">Ver</a></td></tr>
    }
    </tbody>
</table></div>
<a asp-controller="Organizaciones" asp-action="Details" asp-route-id="@Model.OrganizacionId">Volver a la organización</a>

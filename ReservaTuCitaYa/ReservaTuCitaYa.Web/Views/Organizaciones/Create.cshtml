@model ReservaTuCitaYa.Web.ViewModels.Organizaciones.OrganizacionFormularioViewModel
@{
    ViewData["Title"] = "Nueva organización";
}

<h1>Nueva organización</h1>
<p class="text-muted">Registre los datos generales de la organización.</p>
<form asp-action="Create" method="post" class="card card-body">
    <partial name="_Formulario" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

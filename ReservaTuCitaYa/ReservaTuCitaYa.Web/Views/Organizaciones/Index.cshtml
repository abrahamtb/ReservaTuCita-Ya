@using ReservaTuCitaYa.Application.DTOs.Common
@model ReservaTuCitaYa.Web.ViewModels.Organizaciones.OrganizacionIndexViewModel
@{
    ViewData["Title"] = "Organizaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Organizaciones</h1>
        <span class="text-muted">Administre organizaciones y sus sedes.</span>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nueva organización</a>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-7">
            <label asp-for="Busqueda" class="form-label">Buscar</label>
            <input asp-for="Busqueda" class="form-control" placeholder="Nombre, razón social o documento" />
        </div>
        <div class="col-md-3">
            <label asp-for="Estado" class="form-label">Estado</label>
            <select asp-for="Estado" class="form-select">
                <option value="@EstadoFiltro.Todos">Todos</option>
                <option value="@EstadoFiltro.Activos">Activos</option>
                <option value="@EstadoFiltro.Inactivos">Inactivos</option>
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-outline-primary" type="submit">Filtrar</button>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Nombre comercial</th><th>Documento</th><th>Tipo</th><th>Contacto</th><th>Estado</th><th class="text-end">Acciones</th></tr>
        </thead>
        <tbody>
        @if (Model.Organizaciones.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron organizaciones.</td></tr>
        }
        @foreach (var organizacion in Model.Organizaciones)
        {
            <tr>
                <td>@organizacion.NombreComercial</td>
                <td>@organizacion.NumeroDocumento</td>
                <td>@organizacion.TipoOrganizacion</td>
                <td>@(organizacion.Correo ?? organizacion.Telefono ?? "—")</td>
                <td><span class="badge @(organizacion.EstaActivo ? "bg-success" : "bg-secondary")">@(organizacion.EstaActivo ? "Activo" : "Inactivo")</span></td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@organizacion.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                    <a asp-controller="Sedes" asp-action="Index" asp-route-organizacionId="@organizacion.Id" class="btn btn-sm btn-outline-secondary">Sedes</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

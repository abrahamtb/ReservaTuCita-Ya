@model ReservaTuCitaYa.Web.ViewModels.Organizaciones.OrganizacionFormularioViewModel
@{
    ViewData["Title"] = "Editar organización";
}

<h1>Editar organización</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body">
    <input asp-for="Id" type="hidden" />
    <partial name="_Formulario" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

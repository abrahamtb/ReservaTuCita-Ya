@model ReservaTuCitaYa.Application.DTOs.Organizaciones.OrganizacionDetalleDto
@{
    ViewData["Title"] = "Detalle de organización";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1>@Model.NombreComercial</h1>
        <span class="badge @(Model.EstaActivo ? "bg-success" : "bg-secondary")">@(Model.EstaActivo ? "Activa" : "Inactiva")</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        <a asp-controller="Sedes" asp-action="Index" asp-route-organizacionId="@Model.Id" class="btn btn-outline-primary">Administrar sedes (@Model.CantidadSedesActivas)</a>
        <a asp-controller="CategoriasServicio" asp-action="Index" asp-route-organizacionId="@Model.Id" class="btn btn-outline-primary">Categorías</a>
        <a asp-controller="Servicios" asp-action="Index" asp-route-organizacionId="@Model.Id" class="btn btn-outline-primary">Servicios</a>
    </div>
</div>

<div class="card mb-3"><div class="card-body"><dl class="row mb-0">
    <dt class="col-sm-3">Tipo</dt><dd class="col-sm-9">@Model.TipoOrganizacion</dd>
    <dt class="col-sm-3">Razón social</dt><dd class="col-sm-9">@(Model.RazonSocial ?? "—")</dd>
    <dt class="col-sm-3">Documento</dt><dd class="col-sm-9">@Model.NumeroDocumento</dd>
    <dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@(Model.Telefono ?? "—")</dd>
    <dt class="col-sm-3">Correo</dt><dd class="col-sm-9">@(Model.Correo ?? "—")</dd>
    <dt class="col-sm-3">Dirección</dt><dd class="col-sm-9">@(Model.DireccionPrincipal ?? "—")</dd>
    <dt class="col-sm-3">Creada</dt><dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
</dl></div></div>

<div class="d-flex gap-2 flex-wrap">
    <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Confirma el cambio de estado?');">
        <button class="btn btn-outline-warning" type="submit">@(Model.EstaActivo ? "Desactivar" : "Activar")</button>
    </form>
    <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar esta organización? Esta acción la ocultará del sistema.');">
        <button class="btn btn-outline-danger" type="submit">Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-link">Volver</a>
</div>

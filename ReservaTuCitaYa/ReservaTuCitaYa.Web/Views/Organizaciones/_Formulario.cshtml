@model ReservaTuCitaYa.Web.ViewModels.Organizaciones.OrganizacionFormularioViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="TipoOrganizacionId" class="form-label"></label>
        <select asp-for="TipoOrganizacionId" asp-items="Model.TiposOrganizacion" class="form-select">
            <option value="">Seleccione...</option>
        </select>
        <span asp-validation-for="TipoOrganizacionId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="NombreComercial" class="form-label"></label>
        <input asp-for="NombreComercial" class="form-control" />
        <span asp-validation-for="NombreComercial" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="RazonSocial" class="form-label"></label>
        <input asp-for="RazonSocial" class="form-control" />
        <span asp-validation-for="RazonSocial" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="NumeroDocumento" class="form-label"></label>
        <input asp-for="NumeroDocumento" class="form-control" />
        <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Telefono" class="form-label"></label>
        <input asp-for="Telefono" class="form-control" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="DireccionPrincipal" class="form-label"></label>
        <input asp-for="DireccionPrincipal" class="form-control" />
        <span asp-validation-for="DireccionPrincipal" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="LogoUrl" class="form-label"></label>
        <input asp-for="LogoUrl" class="form-control" />
        <span asp-validation-for="LogoUrl" class="text-danger"></span>
    </div>
</div>

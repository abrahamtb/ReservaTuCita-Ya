@model ReservaTuCitaYa.Application.DTOs.CategoriasServicio.CategoriaServicioDetalleDto
@{ ViewData["Title"] = "Detalle de categoría"; }
<div class="d-flex justify-content-between align-items-start mb-3">
    <div><h1>@Model.Nombre</h1><p class="text-muted">@Model.Organizacion</p><span class="badge @(Model.EstaActivo ? "bg-success" : "bg-secondary")">@(Model.EstaActivo ? "Activa" : "Inactiva")</span></div>
    <div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a><a asp-controller="Servicios" asp-action="Index" asp-route-organizacionId="@Model.OrganizacionId" asp-route-categoriaServicioId="@Model.Id" class="btn btn-outline-primary">Ver servicios</a></div>
</div>
<div class="card mb-3"><div class="card-body"><dl class="row mb-0">
    <dt class="col-sm-3">Descripción</dt><dd class="col-sm-9">@(Model.Descripcion ?? "—")</dd>
    <dt class="col-sm-3">Servicios</dt><dd class="col-sm-9">@Model.CantidadServicios (@Model.CantidadServiciosActivos activos)</dd>
    <dt class="col-sm-3">Creada</dt><dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Última modificación</dt><dd class="col-sm-9">@(Model.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
</dl></div></div>
@if (Model.EstaActivo && Model.CantidadServiciosActivos > 0) { <div class="alert alert-warning">Esta categoría tiene @Model.CantidadServiciosActivos servicio(s) activo(s). Desactivarla no modificará esos servicios.</div> }
<div class="d-flex gap-2 flex-wrap">
    <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('@(Model.EstaActivo && Model.CantidadServiciosActivos > 0 ? "La categoría tiene servicios activos. ¿Desea desactivarla sin modificar esos servicios?" : "¿Confirma el cambio de estado?")');"><input type="hidden" name="confirmarServiciosActivos" value="@(Model.CantidadServiciosActivos > 0 ? "true" : "false")" /><button class="btn btn-outline-warning" type="submit">@(Model.EstaActivo ? "Desactivar" : "Activar")</button></form>
    <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar esta categoría? Solo será posible si no tiene servicios asociados.');"><button class="btn btn-outline-danger" type="submit">Eliminar</button></form>
    <a asp-action="Index" asp-route-organizacionId="@Model.OrganizacionId" class="btn btn-link">Volver</a>
</div>

@using ReservaTuCitaYa.Application.DTOs.Common
@model ReservaTuCitaYa.Web.ViewModels.CategoriasServicio.CategoriaServicioIndexViewModel
@{ ViewData["Title"] = "Categorías de servicio"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="mb-0">Categorías</h1><span class="text-muted">@Model.Organizacion</span></div>
    <a asp-action="Create" asp-route-organizacionId="@Model.OrganizacionId" class="btn btn-primary">Nueva categoría</a>
</div>
<form method="get" class="card card-body mb-3">
    <input type="hidden" asp-for="OrganizacionId" />
    <div class="row g-2 align-items-end">
        <div class="col-md-7"><label asp-for="Busqueda" class="form-label">Buscar</label><input asp-for="Busqueda" class="form-control" placeholder="Nombre o descripción" /></div>
        <div class="col-md-3"><label asp-for="Estado" class="form-label">Estado</label><select asp-for="Estado" class="form-select"><option value="@EstadoFiltro.Todos">Todos</option><option value="@EstadoFiltro.Activos">Activos</option><option value="@EstadoFiltro.Inactivos">Inactivos</option></select></div>
        <div class="col-md-2 d-grid"><button type="submit" class="btn btn-outline-primary">Filtrar</button></div>
    </div>
</form>
<div class="table-responsive"><table class="table table-striped align-middle">
    <thead><tr><th>Nombre</th><th>Descripción</th><th>Servicios</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @if (Model.Resultado.Elementos.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">No se encontraron categorías.</td></tr> }
    @foreach (var categoria in Model.Resultado.Elementos) {
        <tr><td>@categoria.Nombre</td><td>@(categoria.Descripcion ?? "—")</td><td>@categoria.CantidadServicios</td><td><span class="badge @(categoria.EstaActivo ? "bg-success" : "bg-secondary")">@(categoria.EstaActivo ? "Activa" : "Inactiva")</span></td><td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-primary">Ver</a><a asp-controller="Servicios" asp-action="Index" asp-route-organizacionId="@Model.OrganizacionId" asp-route-categoriaServicioId="@categoria.Id" class="btn btn-sm btn-outline-secondary ms-1">Servicios</a></td></tr>
    }
    </tbody>
</table></div>
<nav aria-label="Paginación"><ul class="pagination">
    <li class="page-item @(!Model.Resultado.TieneAnterior ? "disabled" : null)"><a class="page-link" asp-route-organizacionId="@Model.OrganizacionId" asp-route-busqueda="@Model.Busqueda" asp-route-estado="@Model.Estado" asp-route-pagina="@(Model.Resultado.PaginaActual - 1)">Anterior</a></li>
    <li class="page-item disabled"><span class="page-link">Página @Model.Resultado.PaginaActual de @Model.Resultado.TotalPaginas</span></li>
    <li class="page-item @(!Model.Resultado.TieneSiguiente ? "disabled" : null)"><a class="page-link" asp-route-organizacionId="@Model.OrganizacionId" asp-route-busqueda="@Model.Busqueda" asp-route-estado="@Model.Estado" asp-route-pagina="@(Model.Resultado.PaginaActual + 1)">Siguiente</a></li>
</ul></nav>
<div class="d-flex gap-3"><a asp-controller="Organizaciones" asp-action="Details" asp-route-id="@Model.OrganizacionId">Volver a la organización</a><a asp-controller="Servicios" asp-action="Index" asp-route-organizacionId="@Model.OrganizacionId">Ver todos los servicios</a></div>

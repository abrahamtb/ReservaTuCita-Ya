@model ReservaTuCitaYa.Web.ViewModels.CategoriasServicio.CategoriaServicioFormularioViewModel
<input asp-for="OrganizacionId" type="hidden" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<p><strong>Organización:</strong> @Model.Organizacion</p>
<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>

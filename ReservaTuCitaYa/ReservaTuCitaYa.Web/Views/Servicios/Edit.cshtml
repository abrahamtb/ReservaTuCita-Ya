@model ReservaTuCitaYa.Web.ViewModels.Servicios.ServicioFormularioViewModel
@{ ViewData["Title"] = "Editar servicio"; }
<h1>Editar servicio</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body"><input asp-for="Id" type="hidden" /><partial name="_Formulario" model="Model" /><div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Guardar cambios</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><partial name="_FormularioScripts" /> }

@model ReservaTuCitaYa.Application.DTOs.Servicios.ServicioDetalleDto
@{ ViewData["Title"] = "Detalle de servicio"; }
<div class="d-flex justify-content-between align-items-start mb-3"><div><h1>@Model.Nombre</h1><p class="text-muted">@Model.Organizacion · @Model.Categoria</p><span class="badge @(Model.EstaActivo ? "bg-success" : "bg-secondary")">@(Model.EstaActivo ? "Activo" : "Inactivo")</span></div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a></div>
<div class="card mb-3"><div class="card-body"><dl class="row mb-0">
<dt class="col-sm-3">Descripción</dt><dd class="col-sm-9">@(Model.Descripcion ?? "—")</dd><dt class="col-sm-3">Modalidad y duración</dt><dd class="col-sm-9">@Model.Modalidad · @Model.DuracionMinutos minutos</dd><dt class="col-sm-3">Precio general</dt><dd class="col-sm-9">S/ @Model.Precio.ToString("N2")</dd><dt class="col-sm-3">Adelanto</dt><dd class="col-sm-9">S/ @Model.MontoAdelanto.ToString("N2")</dd><dt class="col-sm-3">Capacidad</dt><dd class="col-sm-9">@(Model.EsGrupal ? $"Grupal, máximo {Model.CapacidadMaxima}" : "Individual")</dd><dt class="col-sm-3">Requisitos</dt><dd class="col-sm-9">Profesional: @(Model.RequiereProfesional ? "Sí" : "No") · Recurso: @(Model.RequiereRecurso ? "Sí" : "No")</dd><dt class="col-sm-3">Cambios de cita</dt><dd class="col-sm-9">Cancelación: @(Model.PermiteCancelacion ? "Sí" : "No") · Reprogramación: @(Model.PermiteReprogramacion ? "Sí" : "No") · Límite: @Model.HorasLimiteCancelacion h</dd><dt class="col-sm-3">Tiempos adicionales</dt><dd class="col-sm-9">Preparación: @Model.TiempoPreparacionMinutos min · Posterior: @Model.TiempoPosteriorMinutos min</dd><dt class="col-sm-3">Creado</dt><dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
</dl></div></div>
<h2 class="h4">Sedes asignadas</h2><div class="table-responsive mb-3"><table class="table table-sm"><thead><tr><th>Sede</th><th>Estado</th><th>Precio especial</th><th>Precio aplicable</th></tr></thead><tbody>@if (Model.Sedes.Count == 0) { <tr><td colspan="4" class="text-muted">No tiene sedes asignadas.</td></tr> } @foreach (var sede in Model.Sedes) { <tr><td>@sede.Sede</td><td>@(sede.SedeActiva ? "Activa" : "Inactiva")</td><td>@(sede.PrecioEspecial.HasValue ? $"S/ {sede.PrecioEspecial.Value:N2}" : "—")</td><td>S/ @sede.PrecioAplicable.ToString("N2")</td></tr> }</tbody></table></div>
<div class="d-flex gap-2 flex-wrap"><form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Confirma el cambio de estado?');"><button class="btn btn-outline-warning" type="submit">@(Model.EstaActivo ? "Desactivar" : "Activar")</button></form><form asp-action="Eliminar" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar este servicio? Se conservará su historial y sus relaciones.');"><button class="btn btn-outline-danger" type="submit">Eliminar</button></form><a asp-action="Index" asp-route-organizacionId="@Model.OrganizacionId" class="btn btn-link">Volver</a></div>

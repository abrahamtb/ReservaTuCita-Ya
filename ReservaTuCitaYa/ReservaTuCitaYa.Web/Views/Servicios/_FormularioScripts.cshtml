<script>
    document.querySelectorAll('.sede-check').forEach(function (check) {
        const actualizar = function () {
            const precio = document.querySelector('.precio-especial[data-index="' + check.dataset.index + '"]');
            precio.disabled = !check.checked;
            if (!check.checked) precio.value = '';
        };
        check.addEventListener('change', actualizar);
        actualizar();
    });
    const grupal = document.querySelector('[data-grupal]');
    const capacidad = document.querySelector('[data-capacidad]');
    if (grupal && capacidad) grupal.addEventListener('change', function () { if (!grupal.checked) capacidad.value = 1; });
</script>

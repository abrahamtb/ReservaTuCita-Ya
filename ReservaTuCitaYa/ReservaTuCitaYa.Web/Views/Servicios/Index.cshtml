@using ReservaTuCitaYa.Application.DTOs.Common
@using ReservaTuCitaYa.Domain.Enums
@model ReservaTuCitaYa.Web.ViewModels.Servicios.ServicioIndexViewModel
@{ ViewData["Title"] = "Servicios"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="mb-0">Servicios</h1><span class="text-muted">@Model.Organizacion</span></div><a asp-action="Create" asp-route-organizacionId="@Model.OrganizacionId" class="btn btn-primary">Nuevo servicio</a></div>
<form method="get" class="card card-body mb-3"><input type="hidden" asp-for="OrganizacionId" /><div class="row g-2 align-items-end">
    <div class="col-lg-4"><label asp-for="Busqueda" class="form-label">Buscar</label><input asp-for="Busqueda" class="form-control" placeholder="Nombre o descripción" /></div>
    <div class="col-lg-3"><label asp-for="CategoriaServicioId" class="form-label">Categoría</label><select asp-for="CategoriaServicioId" asp-items="Model.Categorias" class="form-select"><option value="">Todas</option></select></div>
    <div class="col-lg-2"><label asp-for="Modalidad" class="form-label"></label><select asp-for="Modalidad" class="form-select"><option value="">Todas</option><option value="@ModalidadServicio.Presencial">Presencial</option><option value="@ModalidadServicio.Virtual">Virtual</option><option value="@ModalidadServicio.Domicilio">Domicilio</option></select></div>
    <div class="col-lg-2"><label asp-for="Estado" class="form-label"></label><select asp-for="Estado" class="form-select"><option value="@EstadoFiltro.Todos">Todos</option><option value="@EstadoFiltro.Activos">Activos</option><option value="@EstadoFiltro.Inactivos">Inactivos</option></select></div>
    <div class="col-lg-1 d-grid"><button class="btn btn-outline-primary" type="submit">Ir</button></div>
</div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Nombre</th><th>Categoría</th><th>Modalidad</th><th>Duración</th><th>Precio / adelanto</th><th>Tipo</th><th>Sedes</th><th>Estado</th><th></th></tr></thead><tbody>
@if (Model.Resultado.Elementos.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-4">No se encontraron servicios.</td></tr> }
@foreach (var servicio in Model.Resultado.Elementos) { <tr><td>@servicio.Nombre</td><td>@servicio.Categoria</td><td>@servicio.Modalidad</td><td>@servicio.DuracionMinutos min</td><td>S/ @servicio.Precio.ToString("N2") / S/ @servicio.MontoAdelanto.ToString("N2")</td><td>@(servicio.EsGrupal ? $"Grupal ({servicio.CapacidadMaxima})" : "Individual")</td><td>@servicio.CantidadSedes</td><td><span class="badge @(servicio.EstaActivo ? "bg-success" : "bg-secondary")">@(servicio.EstaActivo ? "Activo" : "Inactivo")</span></td><td><a asp-action="Details" asp-route-id="@servicio.Id" class="btn btn-sm btn-outline-primary">Ver</a></td></tr> }
</tbody></table></div>
<nav><ul class="pagination"><li class="page-item @(!Model.Resultado.TieneAnterior ? "disabled" : null)"><a class="page-link" asp-route-organizacionId="@Model.OrganizacionId" asp-route-busqueda="@Model.Busqueda" asp-route-categoriaServicioId="@Model.CategoriaServicioId" asp-route-modalidad="@Model.Modalidad" asp-route-estado="@Model.Estado" asp-route-pagina="@(Model.Resultado.PaginaActual - 1)">Anterior</a></li><li class="page-item disabled"><span class="page-link">Página @Model.Resultado.PaginaActual de @Model.Resultado.TotalPaginas</span></li><li class="page-item @(!Model.Resultado.TieneSiguiente ? "disabled" : null)"><a class="page-link" asp-route-organizacionId="@Model.OrganizacionId" asp-route-busqueda="@Model.Busqueda" asp-route-categoriaServicioId="@Model.CategoriaServicioId" asp-route-modalidad="@Model.Modalidad" asp-route-estado="@Model.Estado" asp-route-pagina="@(Model.Resultado.PaginaActual + 1)">Siguiente</a></li></ul></nav>
<div class="d-flex gap-3"><a asp-controller="Organizaciones" asp-action="Details" asp-route-id="@Model.OrganizacionId">Volver a la organización</a><a asp-controller="CategoriasServicio" asp-action="Index" asp-route-organizacionId="@Model.OrganizacionId">Administrar categorías</a></div>

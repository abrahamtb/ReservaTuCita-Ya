@using ReservaTuCitaYa.Domain.Enums
@model ReservaTuCitaYa.Web.ViewModels.Servicios.ServicioFormularioViewModel
<input asp-for="OrganizacionId" type="hidden" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<p><strong>Organización:</strong> @Model.Organizacion</p>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="CategoriaServicioId" class="form-label"></label><select asp-for="CategoriaServicioId" asp-items="Model.Categorias" class="form-select"><option value="">Seleccione...</option></select><span asp-validation-for="CategoriaServicioId" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" class="form-control" rows="3"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="DuracionMinutos" class="form-label"></label><input asp-for="DuracionMinutos" class="form-control" /><span asp-validation-for="DuracionMinutos" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Precio" class="form-label"></label><input asp-for="Precio" class="form-control" /><span asp-validation-for="Precio" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="MontoAdelanto" class="form-label"></label><input asp-for="MontoAdelanto" class="form-control" /><span asp-validation-for="MontoAdelanto" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Modalidad" class="form-label"></label><select asp-for="Modalidad" class="form-select"><option value="">Seleccione...</option><option value="@ModalidadServicio.Presencial">Presencial</option><option value="@ModalidadServicio.Virtual">Virtual</option><option value="@ModalidadServicio.Domicilio">Domicilio</option></select><span asp-validation-for="Modalidad" class="text-danger"></span></div>
    <div class="col-md-3 form-check ms-2"><input asp-for="EsGrupal" class="form-check-input" data-grupal /><label asp-for="EsGrupal" class="form-check-label"></label></div>
    <div class="col-md-3"><label asp-for="CapacidadMaxima" class="form-label"></label><input asp-for="CapacidadMaxima" class="form-control" data-capacidad /><span asp-validation-for="CapacidadMaxima" class="text-danger"></span></div>
    <div class="col-12 d-flex gap-4 flex-wrap"><div class="form-check"><input asp-for="RequiereProfesional" class="form-check-input" /><label asp-for="RequiereProfesional" class="form-check-label"></label></div><div class="form-check"><input asp-for="RequiereRecurso" class="form-check-input" /><label asp-for="RequiereRecurso" class="form-check-label"></label></div><div class="form-check"><input asp-for="PermiteCancelacion" class="form-check-input" /><label asp-for="PermiteCancelacion" class="form-check-label"></label></div><div class="form-check"><input asp-for="PermiteReprogramacion" class="form-check-input" /><label asp-for="PermiteReprogramacion" class="form-check-label"></label></div></div>
    <div class="col-md-4"><label asp-for="HorasLimiteCancelacion" class="form-label"></label><input asp-for="HorasLimiteCancelacion" class="form-control" /><span asp-validation-for="HorasLimiteCancelacion" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="TiempoPreparacionMinutos" class="form-label"></label><input asp-for="TiempoPreparacionMinutos" class="form-control" /><span asp-validation-for="TiempoPreparacionMinutos" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="TiempoPosteriorMinutos" class="form-label"></label><input asp-for="TiempoPosteriorMinutos" class="form-control" /><span asp-validation-for="TiempoPosteriorMinutos" class="text-danger"></span></div>
</div>
<hr class="my-4" /><h2 class="h5">Sedes donde se ofrece</h2>
@if (Model.Sedes.Count == 0) { <p class="text-muted">La organización no tiene sedes activas disponibles.</p> }
@for (var i = 0; i < Model.Sedes.Count; i++) {
    <div class="row align-items-center border rounded p-2 mb-2">
        <input asp-for="Sedes[i].SedeId" type="hidden" /><input asp-for="Sedes[i].Nombre" type="hidden" />
        <div class="col-md-6 form-check ms-3"><input asp-for="Sedes[i].Seleccionada" class="form-check-input sede-check" data-index="@i" /><label asp-for="Sedes[i].Seleccionada" class="form-check-label">@Model.Sedes[i].Nombre</label></div>
        <div class="col-md-5"><label asp-for="Sedes[i].PrecioEspecial" class="form-label"></label><input asp-for="Sedes[i].PrecioEspecial" class="form-control precio-especial" data-index="@i" disabled="@(!Model.Sedes[i].Seleccionada)" placeholder="Usar precio general" /><span asp-validation-for="Sedes[i].PrecioEspecial" class="text-danger"></span></div>
    </div>
}
